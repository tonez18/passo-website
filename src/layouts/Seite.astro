---
// Rahmen aller Seiten: <head>, Vorabskript für das Design, Kopf, Inhalt, Fuß, Skripte.
import '../stile/farben.css';
import '../stile/basis.css';
import '../stile/karte.css';
import '../stile/bewegung.css';
import Symbole from '../bausteine/Symbole.astro';
import Kopf from '../bausteine/Kopf.astro';
import Fuss from '../bausteine/Fuss.astro';
import { einstellungen, pfad, absolut } from '../einstellungen';

interface Props {
  titel: string;
  beschreibung: string;
  /** Pfad der Seite ohne Unterpfad, z. B. '/' oder '/plaene/'. */
  pfadname: string;
  teilbild?: string;
  jsonLd?: object[];
  /** Starttext der Positionsanzeige im Kopf (Seiten mit Route). */
  position?: string;
}
const { titel, beschreibung, pfadname, position } = Astro.props;
---
<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{titel}</title>
<meta name="description" content={beschreibung}>
<link rel="canonical" href={absolut(pfadname)}>
{!einstellungen.indexierbar && <meta name="robots" content="noindex, nofollow">}
<link rel="icon" type="image/svg+xml" href={pfad('/favicon.svg')}>
<!-- Vorabskript: setzt das Design vor dem ersten Zeichnen (kein Aufblitzen). „js“ schaltet Umschalter und Menü ein,
     „anim“ die Startzustände der Bewegung; ohne JavaScript oder mit „Bewegung reduzieren“ steht alles im Endzustand. -->
<script is:inline>
(function(){var d=document.documentElement,t=null;try{t=localStorage.getItem('passo-thema')}catch(e){}
if(t!=='dunkel'&&t!=='hell')t=matchMedia('(prefers-color-scheme: light)').matches?'hell':'dunkel';
d.setAttribute('data-thema',t);d.classList.add('js');
if(matchMedia('(prefers-reduced-motion: reduce)').matches)d.setAttribute('data-ruhig','');else d.classList.add('anim');})();
</script>
</head>
<body>
<a class="vh" href="#inhalt">Zum Inhalt springen</a>
<Symbole />
<Kopf pfadname={pfadname} position={position} />
<main id="inhalt">
<slot />
</main>
<Fuss />
<script>
  import '../skripte/thema';
  import '../skripte/menue';
  import '../skripte/bewegung';
</script>
</body>
</html>
