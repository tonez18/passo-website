---
// „Fertige Pläne“ auf der Startseite: die ersten drei Pläne aus dem Ordner plaene/, jede Karte führt zu ihrer Planseite.
import Plankarte from './Plankarte.astro';
import { sammlePlaene } from '../plaene/sammlung';
import { skala } from '../plaene/darstellung';
import { pfad } from '../einstellungen';
const alle = await sammlePlaene();
const max = skala(alle.map((e) => e.plan.wochen.map((w) => w.minuten)));
---
<div class="plans">
  {alle.slice(0, 3).map((eintrag, i) => <Plankarte eintrag={eintrag} nummer={i} art="vorschau" max={max} />)}
</div>
<a class="more rv" href={pfad('/plaene/')}>Alle Pläne ansehen<svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
