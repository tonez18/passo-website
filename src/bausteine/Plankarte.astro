---
// Plankarte: Name, gekürzte Beschreibung, Werte und Wochenlast. Die ganze Karte ist der Link zur Planseite.
// „tour“ ist die Karte der Planübersicht (Tournummer, drei Werte), „vorschau“ die schlankere der Startseite
// (zwei Werte, Beschreibung stärker gekürzt).
import Wochenlast from './Wochenlast.astro';
import type { Eintrag } from '../plaene/sammlung';
import { werte, kurz } from '../plaene/darstellung';
import { pfad } from '../einstellungen';
interface Props {
  eintrag: Eintrag;
  /** Stelle in der Liste, ab 0: Tournummer und Staffelung beim Einblenden. */
  nummer?: number;
  art?: 'tour' | 'vorschau';
  /** Oberes Ende der Wochenlast in Minuten (skala()). */
  max?: number;
}
const { eintrag, nummer = 0, art = 'tour', max = 300 } = Astro.props;
const { plan } = eintrag;
const [wochen, einheiten, stunden] = werte(plan);
---
<a class="plan rv" href={pfad(`/plaene/${eintrag.slug}/`)} style={`--i:${nummer % 3}`}>
  <span class="clipg"><i class="glow"></i></span>
  {art === 'tour'
    ? <span class="tourn"><i>{nummer + 1}</i>Tour {nummer + 1}</span>
    : <span class="plan-k"><span class="chip">{wochen}</span><span class="chip">{einheiten} pro Woche</span></span>}
  <h3>{plan.name}</h3>
  <p>{kurz(plan.beschreibung, art === 'tour' ? 118 : 90)}</p>
  {art === 'tour' && <span class="plan-k"><span class="chip">{wochen}</span><span class="chip">{einheiten}</span><span class="chip">{stunden}</span></span>}
  <Wochenlast wochen={plan.wochen} max={max} />
</a>
