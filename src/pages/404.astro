---
// 404 im Kartenmotiv: Der Weg ist nicht auf der Karte. Die Route läuft ins Leere; zwei Wege führen zurück.
import Seite from '../layouts/Seite.astro';
import KartenKopf from '../bausteine/KartenKopf.astro';
import Knopf from '../bausteine/Knopf.astro';
import { einstellungen, pfad } from '../einstellungen';
const plaene = einstellungen.plaeneZeigen;
---
<Seite
  titel="Seite nicht gefunden | Passo"
  beschreibung={plaene ? 'Diese Seite gibt es nicht. Zurück zur Startseite oder zu den Trainingsplänen.' : 'Diese Seite gibt es nicht. Zurück zur Startseite oder zu den Funktionen.'}
  pfadname="/404.html"
  ohneIndex
>
<div class="page" id="page">
  <KartenKopf>
    <div class="wrap hero-s-in nf">
      <p class="crumb">Fehler 404 · Blatt fehlt</p>
      <h1>Dieser Weg ist nicht auf der Karte</h1>
      <p class="sub">Die Seite gibt es nicht oder nicht mehr. Zurück auf die Route kommst du hier:</p>
      <div class="cta">
        <Knopf href={pfad('/')}>Zur Startseite</Knopf>
        {plaene
          ? <Knopf href={pfad('/plaene/')} art="neben">Zu den Plänen</Knopf>
          : <Knopf href={pfad('/') + '#funktionen'} art="neben">Zu den Funktionen</Knopf>}
      </div>
    </div>
  </KartenKopf>
  <section class="wrap nf-sec">
    <div class="nf-il rv">
      <svg viewBox="0 0 1120 320" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Kartenausschnitt: Die Route endet mitten im Gelände, dahinter ist die Karte leer">
        <defs>
          <linearGradient id="nf-aus" x1="560" y1="0" x2="900" y2="0" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="var(--gedaempft)" stop-opacity=".9"/><stop offset="1" stop-color="var(--gedaempft)" stop-opacity="0"/></linearGradient>
          <linearGradient id="nf-leer" x1="0" y1="0" x2="1" y2="0"><stop offset=".5" stop-color="var(--flaeche2)" stop-opacity="0"/><stop offset=".86" stop-color="var(--flaeche2)"/></linearGradient>
        </defs>
        <svg class="cut" x="0" y="0" width="1120" height="320" viewBox="180 420 1120 320" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><use href="#tl0"/><use href="#tl1"/></svg>
        <rect width="1120" height="320" fill="url(#nf-leer)"/>
        <path class="nf-weg" d="M-10 262c70-8 110-44 170-40s70 50 130 44 60-76 120-84 78 40 140 22"/>
        <path class="nf-rest" d="M550 204c50-14 80-52 130-56s90 30 150 20 60-30 80-36" stroke="url(#nf-aus)"/>
        <g transform="translate(160 222)"><circle r="9" fill="var(--flaeche)" stroke="var(--route)" stroke-width="2.5"/><circle r="3" fill="var(--route)"/></g>
        <g class="nf-punkt" transform="translate(550 204)"><circle class="nf-ring" r="20"/><circle r="8" fill="var(--route)" stroke="var(--flaeche2)" stroke-width="3"/></g>
        <text class="nf-z" x="550" y="170" text-anchor="middle">km 4,04</text>
        <text class="nf-f" x="965" y="150" text-anchor="middle">?</text>
      </svg>
      <span class="tick"></span><span class="coord">Blatt fehlt · 4 0 4</span>
    </div>
  </section>
</div>
</Seite>
